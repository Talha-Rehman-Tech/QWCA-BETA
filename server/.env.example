# =====================================================================
# QWCA Express API Server - Environment Variables Template
# =====================================================================

# Server Port
PORT=5000

# Environment: 'development' or 'production'
NODE_ENV=development

# ---------------------------------------------------------------------
# Database Connection (MongoDB Atlas vs Local Docker)
# ---------------------------------------------------------------------
# 1. FOR MONGODB ATLAS (Production Cloud):
# Replace <username>, <password>, and <cluster-subdomain> with your Atlas cluster details:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/qwca_database?retryWrites=true&w=majority

# 2. FOR LOCAL DOCKER MONGODB (Development):
MONGODB_URI=mongodb://127.0.0.1:27017/qwca_database

# ---------------------------------------------------------------------
# CORS Allowed Client Origins
# ---------------------------------------------------------------------
# For multiple domains in production, provide a comma-separated list:
# CLIENT_URL=https://qwca.com.pk,https://www.qwca.com.pk,http://localhost:3000
CLIENT_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Single Admin Authentication
# ---------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@qwca.com.pk
ADMIN_PASSWORD=qwcaAdmin@2026!
JWT_SECRET=qwca_jwt_secure_secret_key_987123_managing_partner
JWT_EXPIRES_IN=7d
